# ==============================================================================
# KONFIGURASI APLIKASI (PRODUCTION)
# ==============================================================================
APP_NAME=SIPUDA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://presensi.domainanda.com
APP_PORT=8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ==============================================================================
# DATABASE (MARIADB DOCKER)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=presensi_ubudiyah
DB_USERNAME=sipuda_user
DB_PASSWORD=GantiPasswordKuatDB123!
DB_ROOT_PASSWORD=GantiPasswordRootDB123!

# ==============================================================================
# DRIVER SESSION, CACHE, & QUEUE
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ==============================================================================
# JADWAL SHALAT (KOORDINAT LOKASI PESANTREN)
# ==============================================================================
PRAYER_LATITUDE=-7.0654
PRAYER_LONGITUDE=113.6722
